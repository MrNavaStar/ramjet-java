# .envrc

export VCPKG_ROOT="$PWD/vcpkg"
export VCPKG_DEFAULT_TRIPLET="${VCPKG_DEFAULT_TRIPLET:-x64-linux}"
export CMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake"

if [ -x "$VCPKG_ROOT/downloads/tools/cmake-4.4.2-linux/cmake-4.4.2-linux-x86_64/bin/cmake" ]; then
  export PATH="$VCPKG_ROOT/downloads/tools/cmake-4.4.2-linux/cmake-4.4.2-linux-x86_64/bin:$PATH"
fi

export PATH="$VCPKG_ROOT:$PATH"

if command -v ninja >/dev/null 2>&1; then
  export CMAKE_GENERATOR="Ninja"
elif command -v make >/dev/null 2>&1; then
  export CMAKE_GENERATOR="Unix Makefiles"
fi

if [ ! -x "$VCPKG_ROOT/vcpkg" ] && [ -f "$VCPKG_ROOT/bootstrap-vcpkg.sh" ]; then
  git submodule update --init --recursive
  "$VCPKG_ROOT/bootstrap-vcpkg.sh" -disableMetrics
fi